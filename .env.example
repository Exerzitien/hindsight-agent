# 项目根：data/、语料、.env 都相对它定位。
# 从源码检出运行时留空即可（自动认出仓库根）。
# 把本项目装成 wheel 之后，默认用当前工作目录；想固定到某个目录就设它。
HINDSIGHT_HOME=

# Local databases
HINDSIGHT_INCIDENT_DB=data/incidents/incidents.db
HINDSIGHT_FACTORY_DB=data/factory/factory_zh.db

# Milvus Standalone
MILVUS_URI=http://localhost:19531
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=hindsight_v1

# Local models
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
HINDSIGHT_EMBED_DIM=768
HINDSIGHT_EMBED_BATCH=32

# Retrieval policy (score is relevance, not probability)
HINDSIGHT_TOP_K=8
HINDSIGHT_RELEVANCE_THRESHOLD=0.40
HINDSIGHT_DAILY_BACKFILL_LIMIT=200

# Strands OpenTelemetry -> Jaeger
OTEL_SERVICE_NAME=hindsight-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
HINDSIGHT_ENABLE_TELEMETRY=1

# Set to bedrock only after AWS credentials and model access are configured.
# ollama（默认） | openai | bedrock
HINDSIGHT_MODEL_PROVIDER=ollama
BEDROCK_MODEL_ID=

# provider=openai 时使用。适用于任何 OpenAI 兼容端点：
# vLLM、SGLang、LM Studio、Ollama 的 OpenAI 接口、自建网关。
# 注意 OPENAI_MODEL_ID 是模型标识，不是密钥。
# 端点地址写的是「谁能连上」，不是「谁在跑」——模型跑在你本机而流程跑在
# 容器或远程环境里时，127.0.0.1 指的是各自的本机。
# 例（LM Studio 默认端口）：
#   OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#   OPENAI_MODEL_ID=gemma-2-9b-it
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
OPENAI_API_KEY=

# 留空走本地 JSON 校验（对服务端无额外要求）；
# 设为 strands 则改用服务端严格 response_format。
HINDSIGHT_GENERATOR=

# 模型上下文窗口（token）。留空时本项目会先问服务端，问不到按 8192 算。
# 一次起草的提示词是四位数 token，而本地端点常常默认只装 4096——知道真实
# 数字，才能在发请求之前把语料裁到装得下，而不是收到一个 400。
# 只有在服务端不肯如实上报、而你知道真实值时才需要设它。
HINDSIGHT_MODEL_CONTEXT=
